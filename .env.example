# Copy to `.env` for docker-compose.yaml (Compose reads it for variable
# substitution; the file is not copied into the image). In Portainer, enter
# these values in the stack's environment variables instead.
# Replace /path/to/data in BOTH Compose files with a real absolute host path.

# Host HTTP port and the single container listener port.
PC1_HOST_PORT=8000
PC1_PORT=8000

# Production output is esp32; use console for a container without an ESP32.
PC1_PRINTER_OUTPUT=esp32
# Leave empty for a generated login password stored on /data and logged at boot.
PC1_DEVICE_PASSWORD=
# Required for ESP32 input events/printing; use e.g. `openssl rand -hex 24`.
PC1_RELAY_TOKEN=
# Optional fixed ESP32 URL; otherwise use the address in its heartbeat.
PC1_RELAY_URL=
PC1_SESSION_SECRET=
PC1_CORS_ORIGINS=
TZ=UTC

# Optional credentials/config for print snapshot rendering (local tests only).

# News module (NewsAPI)
PC1_TEST_NEWS_API_KEY=

# Email module (IMAP)
PC1_TEST_EMAIL_USER=
PC1_TEST_EMAIL_APP_PASSWORD=
PC1_TEST_EMAIL_HOST=imap.gmail.com

# RSS module (comma-separated feed URLs)
PC1_TEST_RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://rss.nytimes.com/services/xml/rss/nyt/HomePage.xml

# Calendar module (single ICS URL)
PC1_TEST_CALENDAR_ICS_URL=

# Webhook module
PC1_TEST_WEBHOOK_URL=https://icanhazdadjoke.com/
PC1_TEST_WEBHOOK_METHOD=GET
PC1_TEST_WEBHOOK_JSON_PATH=joke
